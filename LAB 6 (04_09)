{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNhiFzh/NnpKeKyN6lLAARZ"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3677e7f5","executionInfo":{"status":"ok","timestamp":1788514299733,"user_tz":-330,"elapsed":8,"user":{"displayName":"24CSEAIML121 AMRUTANSU PRADHAN","userId":"07348666392602425595"}},"outputId":"6538c2ac-804e-4be4-a978-b051868652c5"},"source":["import math\n","\n","def calculate_entropy(probabilities):\n","    if not probabilities:\n","        raise ValueError(\"List of probabilities cannot be empty.\")\n","    entropy = 0.0\n","    for p in probabilities:\n","        if p < 0 or p > 1:\n","            raise ValueError(\"Probabilities must be between 0 and 1.\")\n","        if p > 0:\n","            entropy -= p * math.log2(p)\n","    return entropy\n","\n","# Example usage:\n","# A fair coin (two outcomes with equal probability)\n","probabilities_coin = [0.5, 0.5]\n","entropy_coin = calculate_entropy(probabilities_coin)\n","print(f\"Entropy of a fair coin: {entropy_coin:.4f} bits\")\n","\n","# A biased coin (e.g., always lands on heads)\n","probabilities_biased_coin = [1.0, 0.0]\n","entropy_biased_coin = calculate_entropy(probabilities_biased_coin)\n","print(f\"Entropy of a biased coin: {entropy_biased_coin:.4f} bits\")\n","\n","# A fair six-sided die\n","probabilities_die = [1/6, 1/6, 1/6, 1/6, 1/6, 1/6]\n","entropy_die = calculate_entropy(probabilities_die)\n","print(f\"Entropy of a fair six-sided die: {entropy_die:.4f} bits\")\n","\n","# A custom distribution\n","probabilities_custom = [0.1, 0.2, 0.3, 0.4]\n","entropy_custom = calculate_entropy(probabilities_custom)\n","print(f\"Entropy of a custom distribution: {entropy_custom:.4f} bits\")\n"],"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["Entropy of a fair coin: 1.0000 bits\n","Entropy of a biased coin: 0.0000 bits\n","Entropy of a fair six-sided die: 2.5850 bits\n","Entropy of a custom distribution: 1.8464 bits\n"]}]}]}